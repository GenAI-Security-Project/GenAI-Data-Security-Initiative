  "@type": "sc:Dataset",
  "name": "agentdataflow_toolexchange_traces",
  "description": "Agent Data Flow and Tool Exchange Traces. Sanitized traces of agentic AI tool calls, plugin data exchanges and delegation chains: typed spans, data classes and sensitivity, findings mapped to DSGAI risks, and a provenance tier with cited evidence.",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "citeAs": "OWASP GenAI Data Security Initiative. Agent Data Flow and Tool Exchange Traces (version 1.0.0). OWASP GenAI Security Project. https://github.com/GenAI-Security-Project/GenAI-Data-Security-Initiative/tree/main/datasets/agentdataflow_toolexchange_traces",
  "dateModified": "2026-09-15",
  "datePublished": "2026-08-07",
  "license": "https://creativecommons.org/licenses/by-sa/4.0/",
  "rai:dataBiases": "Centred on MCP-based tool ecosystems, where most public agent data-flow documentation exists.",
  "rai:dataCollection": "Constructed by contributors as minimal traces of documented agent and MCP behaviour, or as explicitly hypothetical scenarios; each declares its provenance tier and cites evidence.",
  "rai:dataCollectionType": [
    "Manual Human Curator",
    "Document analysis"
  ],
  "rai:dataLimitations": [
    "Very small: a handful of traces so far, all of unintentional failures; adversarial traces are not yet included.",
    "Traces are reconstructions from public documentation or hypothetical, not captured production telemetry."
  ],
  "rai:dataReleaseMaintenancePlan": "Maintained by the OWASP GenAI Data Security Initiative (Workstream 5). Contributions arrive as pull requests and must pass data_validation/run_all_checks.py in CI and peer review; weekly online checks re-verify cited CVEs, advisories and links. Versioned releases carry SHA-256 checksums.",
  "rai:dataSocialImpact": "Supports safer agent designs by making data-exchange failure modes concrete.",
  "rai:dataUseCases": [
    "Studying how sensitive data moves through agent tool calls, and testing agent data-flow analysers.",
    "Worked examples for DSGAI06 and related agent data-exchange risks."
  ],
  "rai:personalSensitiveInformation": "No personal data. Payload values are synthetic placeholders; validate.py fails any trace containing credential, internal-hostname or real-address patterns.",
  "url": "https://github.com/GenAI-Security-Project/GenAI-Data-Security-Initiative/tree/main/datasets/agentdataflow_toolexchange_traces",
  "version": "1.0.0",
