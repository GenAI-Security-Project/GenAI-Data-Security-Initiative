  "@type": "sc:Dataset",
  "name": "riskassessment_dataset",
  "description": "DSGAI Risk Assessment Dataset. Structured risk assessments of GenAI deployment archetypes: for each representative architecture, the DSGAI risks with inherent and residual ratings and rationale, existing controls, control gaps, and alignments to security and AI-governance frameworks.",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "citeAs": "OWASP GenAI Data Security Initiative. DSGAI Risk Assessment Dataset (version 1.0.0). OWASP GenAI Security Project. https://github.com/GenAI-Security-Project/GenAI-Data-Security-Initiative/tree/main/datasets/riskassessment_dataset",
  "dateModified": "2026-05-18",
  "datePublished": "2026-05-18",
  "license": "https://creativecommons.org/licenses/by-sa/4.0/",
  "rai:dataBiases": [
    "Sector coverage is uneven: cross-sector templates are the largest group, followed by financial services and SaaS; several sectors have a single template.",
    "Framework alignments reflect the frameworks contributors know best."
  ],
  "rai:dataCollection": "Written by initiative contributors as synthetic-but-realistic templates of common deployment patterns, informed by public guidance and practitioner experience; peer reviewed.",
  "rai:dataCollectionType": "Manual Human Curator",
  "rai:dataLimitations": [
    "Every entry is a synthetic template of a deployment archetype, not an assessment of a real organisation.",
    "Ratings and control gaps are expert judgments for the described archetype; a real deployment needs its own assessment."
  ],
  "rai:dataReleaseMaintenancePlan": "Maintained by the OWASP GenAI Data Security Initiative (Workstream 5). Contributions arrive as pull requests and must pass data_validation/run_all_checks.py in CI and peer review; weekly online checks re-verify cited CVEs, advisories and links. Versioned releases carry SHA-256 checksums.",
  "rai:dataSocialImpact": "Lowers the cost of structured GenAI risk assessment for smaller organisations.",
  "rai:dataUseCases": [
    "Starting points and worked examples for GenAI risk assessments and DSGAI training.",
    "Benchmark scenarios for comparing control coverage across deployment patterns."
  ],
  "rai:personalSensitiveInformation": "No personal data: the scenarios are synthetic and describe archetypes, not organisations or people.",
  "url": "https://github.com/GenAI-Security-Project/GenAI-Data-Security-Initiative/tree/main/datasets/riskassessment_dataset",
  "version": "1.0.0",
